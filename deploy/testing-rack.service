[Unit]
Description=Testing rack reservation service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=testing-rack
Group=testing-rack
WorkingDirectory=/opt/testing-rack
ExecStart=/usr/bin/python3 /opt/testing-rack/testing_rack.py serve --config /etc/testing-rack/config.json --state /var/lib/testing-rack/state.json --secret /var/lib/testing-rack/secret.key --bind 0.0.0.0 --port 80
Restart=always
RestartSec=1
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/testing-rack

[Install]
WantedBy=multi-user.target
