[Unit]
Description=Testing rack device connections
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rack
Group=testing-rack
ExecStart=/usr/bin/python3 /opt/testing-rack/warm.py
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/testing-rack-gateway

[Install]
WantedBy=multi-user.target
